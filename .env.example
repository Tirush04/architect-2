# Database (local: `npm run db:local`, prod: Neon pooled URL)
DATABASE_URL="postgresql://architect:architect@localhost:5433/architect"

# Auth.js — generate with `npx auth secret`
AUTH_SECRET=""
AUTH_TRUST_HOST=true

# Optional OAuth (buttons show "not configured" when unset)
AUTH_GITHUB_ID=""
AUTH_GITHUB_SECRET=""
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# Generation engine. Unset key => scripted demo engine.
ANTHROPIC_API_KEY=""
ARCHITECT_MODEL="claude-opus-5"
ARCHITECT_DAILY_LIMIT=25
# Force the scripted engine (tests / offline demos)
ARCHITECT_FAKE_LLM=0
